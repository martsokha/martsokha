{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "coverage", "node_modules"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"paths": {
			"@/*": ["./src/*"],
			"@/assets/*": ["./src/assets/*"],
			"@/components/*": ["./src/components/*"],
			"@/layouts/*": ["./src/layouts/*"],
			"@/pages/*": ["./src/pages/*"]
		},
		"jsx": "preserve"
	}
}
