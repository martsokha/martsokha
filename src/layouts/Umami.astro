---
import { UMAMI_WEBSITE_ID } from "@/config";

/**
 * Umami Analytics Component
 *
 * Integrates Umami analytics tracking script into the application.
 * Umami is a privacy-focused, open-source analytics platform.
 *
 * Set PUBLIC_UMAMI_WEBSITE_ID environment variable to override the default website ID.
 *
 * @see https://umami.is
 * @see https://umami.is/docs
 * @see https://github.com/umami-software/umami
 */

/**
 * Props for the Umami analytics component
 */
export interface Props {
	/**
	 * URL to the Umami analytics script
	 * @default "https://cloud.umami.is/script.js"
	 */
	scriptUrl?: string;

	/**
	 * Unique website identifier for Umami tracking
	 * Can be overridden via PUBLIC_UMAMI_WEBSITE_ID environment variable
	 */
	websiteId?: string;
}

const { scriptUrl = "https://cloud.umami.is/script.js", websiteId = UMAMI_WEBSITE_ID } =
	Astro.props;
---
<script is:inline
    src={scriptUrl}
    data-website-id={websiteId}
    ></script>
