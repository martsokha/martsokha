---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";

import MinLayout from "@/layouts/MinLayout.astro";
import Umami from "@/layouts/Umami.astro";

export interface Props {
	title?: string;
	description?: string;
	withDefaultTitle?: boolean;
	image?: string;
	article?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	author?: string;
	keywords?: string;
}

const {
	title = "Oleh Martsokha",
	description = "Software engineer focused on AI infrastructure and data tooling. Writing about web development, and system design.",
	withDefaultTitle = true,
	image = "/og-image.jpg",
	article,
	publishedTime,
	modifiedTime,
	author = "Oleh Martsokha",
	keywords,
} = Astro.props;
---

<MinLayout
	title={title}
	description={description}
	withDefaultTitle={withDefaultTitle}
	{...(image && { image })}
	{...(article && { article })}
	{...(publishedTime && { publishedTime })}
	{...(modifiedTime && { modifiedTime })}
	{...(author && { author })}
	{...(keywords && { keywords })}
>
	<Umami slot="analytics" />

	<div slot="content" class="flex flex-col min-h-screen">
		<header role="banner" class="shrink-0">
			<Header />
		</header>

		<main id="main-content" role="main" class="flex-1 w-full" tabindex="-1">
			<slot />
		</main>

		<footer role="contentinfo" class="shrink-0">
			<Footer />
		</footer>
	</div>
</MinLayout>
