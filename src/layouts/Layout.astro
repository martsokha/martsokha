---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import MinLayout from "@/layouts/MinLayout.astro";
import Umami from "@/layouts/Umami.astro";

export interface Props {
	title?: string;
	description?: string;
	withDefaultTitle?: boolean;
	image?: string;
	article?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	author?: string;
	keywords?: string;
	noindex?: boolean;
}

const {
	title = "Oleh Martsokha",
	description,
	withDefaultTitle = true,
	image = "/og-image.jpg",
	article,
	publishedTime,
	modifiedTime,
	author = "Oleh Martsokha",
	keywords,
	noindex,
} = Astro.props;
---

<MinLayout
	title={title}
	{...(description && { description })}
	withDefaultTitle={withDefaultTitle}
	{...(image && { image })}
	{...(article && { article })}
	{...(publishedTime && { publishedTime })}
	{...(modifiedTime && { modifiedTime })}
	{...(author && { author })}
	{...(keywords && { keywords })}
	{...(noindex && { noindex })}
>
	<Umami slot="analytics" />

	<div slot="content" class="flex flex-col min-h-screen">
		<Header />

		<main id="main-content" class="flex-1 w-full">
			<slot />
		</main>

		<Footer />
	</div>
</MinLayout>
