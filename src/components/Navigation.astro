---
const currentPath = Astro.url.pathname;

const navItems = [
	{ href: "/", label: "About", id: "about" },
	{ href: "/blog", label: "Writing", id: "writing" },
	{ href: "/projects", label: "Projects", id: "projects" },
];

function isActive(href: string, current: string): boolean {
	if (href === "/") return current === "/";
	return current.startsWith(href);
}
---

<section class="bg-neutral-50 dark:bg-neutral-950 py-12 border-t border-b border-neutral-200 dark:border-neutral-800">
	<div class="container mx-auto px-4 max-w-4xl">
		<!-- Header Text -->
		<div class="mb-8">
			<h2 class="text-4xl md:text-5xl font-bold text-neutral-900 dark:text-neutral-100 mb-4 leading-tight">
				Thoughts & Life Experiences
			</h2>
			<p class="text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-2xl">
				Exploring ideas, sharing insights, and documenting the journey through code, creativity, and life.
			</p>
		</div>

		<!-- Navigation Tabs -->
		<nav class="flex justify-start">
			<div class="flex space-x-8 md:space-x-12">
				{navItems.map((item) => (
					<a
						href={item.href}
						class={`relative pb-3 text-lg font-medium transition-colors duration-200 ${
							isActive(item.href, currentPath)
								? "text-neutral-900 dark:text-neutral-100"
								: "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100"
						}`}
					>
						{item.label}
						{isActive(item.href, currentPath) && (
							<div class="absolute bottom-0 left-0 right-0 h-0.5 bg-neutral-900 dark:bg-neutral-100 rounded-full"></div>
						)}
					</a>
				))}
			</div>
		</nav>
	</div>
</section>
