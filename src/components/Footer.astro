---
import ThemeSwitch from "./ThemeSwitch.vue";

const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-50 dark:bg-neutral-950 border-t border-neutral-300 dark:border-neutral-800 py-8">
	<div class="container mx-auto px-4 max-w-4xl">
		<div class="flex flex-col md:flex-row md:justify-between md:items-center space-y-4 md:space-y-0">
			<!-- Copyright -->
			<div class="text-base text-neutral-500 dark:text-neutral-500 text-center md:text-left">
				© {currentYear} Oleh Martsokha.
			</div>

			<!-- Theme Toggle -->
			<div class="flex justify-center md:justify-end">
				<ThemeSwitch client:load />
			</div>
		</div>
	</div>
</footer>
