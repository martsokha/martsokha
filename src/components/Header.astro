		<div class="flex items-center justify-between">
			<a href="/" class="group">
				<h1 class="font-serif text-2xl md:text-3xl tracking-normal text-neutral-900 dark:text-neutral-100">
					Oleh Martsokha
				</h1>
				<p class="text-sm tracking-normal text-neutral-500 dark:text-neutral-400 mt-1">
					Software Engineer
				</p>
			</a>

			<Socials variant="compact" showEmail={false} />
		</div>
	</div>
</header>
