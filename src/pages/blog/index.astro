---
import { Layout } from "@/layouts";
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide-vue-next";
import { Badge } from "@/components/ui/badge";

// Get all blog posts
const allPosts = await getCollection("posts");
const posts = allPosts
	.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
	.map(post => {
		// Calculate reading time (assuming 200 words per minute)
		const wordCount = post.body.split(/\s+/).length;
		const readingTime = Math.max(1, Math.ceil(wordCount / 200));

		return {
			...post,
			formattedDate: new Date(post.data.publishedAt).toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric'
			}).toUpperCase(),
			readingTime
		};
	});

const pageTitle = "Writing";
const pageDescription = "Thoughts on software engineering, design, and technology.";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="container mx-auto px-4 py-8 md:py-12 lg:py-16 max-w-4xl">
		{posts.length === 0 ? (
			<div class="text-center py-24">
				<div class="text-neutral-600 dark:text-neutral-400 text-xl">
					No posts yet. Check back soon!
				</div>
			</div>
		) : (
			<div class="divide-y divide-neutral-200 dark:divide-neutral-800">
				{posts.map((post, index) => (
					<article class={`group ${index === 0 ? 'pb-12' : 'py-12'}`}>
						<a href={`/blog/${post.id}`} class="block">
							<div class="transition-all duration-300 cursor-pointer">
								<!-- Meta information (date, category, and reading time) -->
								<div class="flex items-center gap-3 text-sm text-neutral-600 dark:text-neutral-400 mb-4 font-medium">
									<time datetime={post.data.publishedAt.toISOString()}>
										{post.formattedDate}
									</time>
									{post.data.category && (
										<>
											<span>•</span>
											<span class="capitalize">{post.data.category}</span>
										</>
									)}
									<span>•</span>
									<span>{post.readingTime} min read</span>
								</div>

								<!-- Title and Read Button -->
								<div class="flex items-start justify-between mb-4">
									<h2 class="text-3xl md:text-4xl font-bold text-black dark:text-white group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors leading-tight flex-1 pr-8">
										{post.data.title}
									</h2>

									<!-- Read Button -->
									<div class="flex items-center text-black dark:text-white group-hover:text-neutral-600 dark:group-hover:text-neutral-400 transition-colors flex-shrink-0">
										<span class="text-base font-semibold">Read</span>
										<ArrowRight client:load class="ml-2 w-5 h-5 transition-transform group-hover:translate-x-1" />
									</div>
								</div>

								<!-- Description -->
								<p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
									{post.data.description}
								</p>

								<!-- Tags at the bottom -->
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="flex flex-wrap gap-2">
										{post.data.tags.map((tag: string) => (
											<Badge variant="outline" class="text-sm px-3 py-1 bg-neutral-50 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800">
												#{tag}
											</Badge>
										))}
									</div>
								)}
							</div>
						</a>
					</article>
				))}
			</div>
		)}
	</div>
</Layout>
