---
import { Layout } from "@/layouts";
import { getCollection } from "astro:content";
import { Badge } from "@/components/ui/badge";

// Get all blog posts
const allPosts = await getCollection("posts");
const posts = allPosts
	.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const pageTitle = "Blog";
const pageDescription = "Thoughts on software engineering, design, and technology.";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="container mx-auto px-4 py-8 max-w-4xl">


		<!-- Header -->
		<div class="mb-16">
			<h1 class="text-4xl font-bold text-neutral-900 dark:text-neutral-100 mb-6">
				Blog
			</h1>
		</div>

		<!-- Blog Posts -->
		{posts.length === 0 ? (
			<div class="text-center py-16">
				<div class="text-neutral-400 dark:text-neutral-600 text-lg">
					No posts yet. Check back soon!
				</div>
			</div>
		) : (
			<div class="space-y-6">
				{posts.map((post) => (
					<article class="group">
						<a href={`/blog/${post.id}`} class="block">
							<div class="border border-neutral-200 dark:border-neutral-800 rounded-xl p-8 transition-all duration-200 hover:border-neutral-300 dark:hover:border-neutral-700 hover:shadow-md dark:hover:shadow-neutral-900/20 cursor-pointer">
								<div class="flex flex-col space-y-4">
									<!-- Title -->
									<h2 class="text-2xl font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-700 dark:group-hover:text-neutral-300 transition-colors">
										{post.data.title}
									</h2>

									<!-- Description -->
									<p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
										{post.data.description}
									</p>

									<!-- Meta and Tags -->
									<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
										<!-- Date -->
										<time class="text-base text-neutral-500 dark:text-neutral-500">
											{new Date(post.data.publishedAt).toLocaleDateString('en-US', {
												year: 'numeric',
												month: 'long',
												day: 'numeric'
											})}
										</time>

										<!-- Tags -->
										{post.data.tags && post.data.tags.length > 0 && (
											<div class="flex flex-wrap gap-2">
												{post.data.tags.slice(0, 3).map((tag: string) => (
													<Badge client:load variant="secondary" class="text-sm">
														{tag}
													</Badge>
												))}
												{post.data.tags.length > 3 && (
													<Badge client:load variant="outline" class="text-sm">
														+{post.data.tags.length - 3} more
													</Badge>
												)}
											</div>
										)}
									</div>
								</div>

								<!-- Read more indicator -->
								<div class="mt-6 flex items-center text-neutral-600 dark:text-neutral-400 group-hover:text-neutral-900 dark:group-hover:text-neutral-100 transition-colors">
									<span class="text-base font-medium">Read article</span>
									<svg
										class="ml-2 w-4 h-4 transition-transform group-hover:translate-x-1"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M17 8l4 4m0 0l-4 4m4-4H3"
										/>
									</svg>
								</div>
							</div>
						</a>
					</article>
				))}
			</div>
		)}


	</div>
</Layout>
