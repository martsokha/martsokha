---
import { Layout } from "@/layouts";
import { getCollection, render } from "astro:content";
import { ArrowLeft, ChevronLeft, ChevronRight } from "lucide-vue-next";
import { Badge } from "@/components/ui/badge";

// Import SVG icons
import BlueskyIcon from "@/assets/icons/bluesky.svg?raw";
import LinkedInIcon from "@/assets/icons/linkedin.svg?raw";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Get all posts for prev/next navigation
const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

const publishedDate = new Date(post.data.publishedAt).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric'
}).toUpperCase();

const readingTime = Math.ceil((post.body || '').split(' ').length / 200);

// Meta information for structured data
const metaInfo = {
	publishedTime: post.data.publishedAt.toISOString(),
	...(post.data.updatedAt && { modifiedTime: post.data.updatedAt.toISOString() })
};

const shareUrl = Astro.url.href;
const shareText = encodeURIComponent(post.data.title);
---

<Layout
	title={post.data.title}
	description={post.data.description}
	article={true}
	hideNavigation={true}
	{...metaInfo}
>
	<article class="container mx-auto px-4 py-8 md:py-12 lg:py-16 max-w-4xl">
		<!-- Back Link and Meta -->
		<div class="mb-6 md:mb-8 pb-4 md:pb-6 border-b border-neutral-200 dark:border-neutral-800">
			<div class="flex items-center justify-between">
				<a
					href="/blog"
					class="inline-flex items-center text-base text-black dark:text-white hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors font-medium"
				>
					<ArrowLeft client:load class="w-5 h-5 mr-3" />
					Back to Writing
				</a>

				<!-- Post Meta -->
				<div class="flex items-center gap-3 text-sm text-neutral-600 dark:text-neutral-400 font-medium">
					{post.data.category && (
						<>
							<Badge variant="default" class="bg-black dark:bg-white text-white dark:text-black text-sm px-3 py-1">
								{post.data.category}
							</Badge>
							<span>•</span>
						</>
					)}
					<time datetime={post.data.publishedAt.toISOString()}>
						{publishedDate}
					</time>
					<span>•</span>
					<span>{readingTime} min read</span>
				</div>
			</div>
		</div>

		<!-- Title and Share -->
		<header class="mb-6 md:mb-8 flex items-center justify-between">
			<h1 class="text-4xl md:text-5xl font-bold text-black dark:text-white leading-tight flex-1 pr-8">
				{post.data.title}
			</h1>

			<!-- Share Buttons -->
			<div class="flex items-center space-x-4 flex-shrink-0">
				<span class="text-base text-neutral-600 dark:text-neutral-400 font-medium">Share</span>
				<a
					href={`https://bsky.app/intent/compose?text=${shareText}%20${encodeURIComponent(shareUrl)}`}
					target="_blank"
					rel="noopener noreferrer"
					class="w-10 h-10 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
					aria-label="Share on Bluesky"
				>
					<div class="w-6 h-6 text-neutral-600 dark:text-neutral-300" set:html={BlueskyIcon} />
				</a>
				<a
					href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
					target="_blank"
					rel="noopener noreferrer"
					class="w-10 h-10 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
					aria-label="Share on LinkedIn"
				>
					<div class="w-6 h-6 text-neutral-600 dark:text-neutral-300" set:html={LinkedInIcon} />
				</a>
			</div>
		</header>

		<!-- Description -->
		<div class="mb-8 md:mb-12">
			<p class="text-xl text-neutral-700 dark:text-neutral-300 leading-relaxed">
				{post.data.description}
			</p>
		</div>

		<!-- Post Content -->
		<div class="prose prose-neutral dark:prose-invert prose-xl max-w-none leading-relaxed mb-12 md:mb-16">
			<Content />
		</div>

		<!-- Tags -->
		{post.data.tags && post.data.tags.length > 0 && (
			<div class="mb-8 md:mb-12 pb-6 md:pb-8 border-b border-neutral-200 dark:border-neutral-800">
				<div class="flex flex-wrap gap-2">
					{post.data.tags.map((tag: string) => (
						<Badge variant="outline" class="text-base px-4 py-2 bg-neutral-50 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
							#{tag}
						</Badge>
					))}
				</div>
			</div>
		)}

		<!-- Previous/Next Navigation -->
		<nav class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
			{prevPost ? (
				<a
					href={`/blog/${prevPost.id}`}
					class="flex items-center group hover:text-black dark:hover:text-white transition-colors"
				>
					<ChevronLeft client:load class="w-5 h-5 text-neutral-400 group-hover:text-current transition-colors mr-3" />
					<div class="text-left">
						<div class="text-sm text-neutral-500 dark:text-neutral-400">Previous</div>
						<div class="font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-current transition-colors">
							{prevPost.data.title}
						</div>
					</div>
				</a>
			) : (
				<div></div>
			)}

			{nextPost ? (
				<a
					href={`/blog/${nextPost.id}`}
					class="flex items-center group hover:text-black dark:hover:text-white transition-colors text-right sm:ml-auto"
				>
					<div class="text-right">
						<div class="text-sm text-neutral-500 dark:text-neutral-400">Next</div>
						<div class="font-medium text-neutral-700 dark:text-neutral-300 group-hover:text-current transition-colors">
							{nextPost.data.title}
						</div>
					</div>
					<ChevronRight client:load class="w-5 h-5 text-neutral-400 group-hover:text-current transition-colors ml-3" />
				</a>
			) : (
				<div></div>
			)}
		</nav>
	</article>
</Layout>
