---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not Found" description="The page you're looking for doesn't exist.">
	<div class="container mx-auto px-6 max-w-3xl min-h-[50vh] flex items-center justify-center">
		<div class="text-center">
			<h1 class="font-serif text-7xl md:text-8xl text-neutral-900 dark:text-neutral-100 mb-4">404</h1>
			<p class="text-neutral-500 dark:text-neutral-400 mb-8">This page doesn't exist.</p>
			<a
				href="/"
				class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-600"
			>
				Back to home
			</a>
		</div>
	</div>
</Layout>
