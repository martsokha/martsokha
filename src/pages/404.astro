---
import { Layout } from "@/layouts";

const pageTitle = "Page Not Found";
const pageDescription = "The page you're looking for doesn't exist.";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-neutral-50 via-white to-neutral-100 dark:from-neutral-950 dark:via-neutral-900 dark:to-neutral-950">
		<div class="container mx-auto px-4 max-w-4xl text-center">
			<div class="max-w-2xl mx-auto">
				<!-- Large 404 with gradient text -->
				<h1 class="text-8xl md:text-9xl font-bold bg-gradient-to-br from-indigo-400 via-purple-500 to-pink-500 bg-clip-text text-transparent mb-6 leading-none">
					404
				</h1>

				<!-- Main heading -->
				<h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white mb-6 leading-tight">
					Oops! Page Not Found
				</h2>

				<!-- Description -->
				<p class="text-lg md:text-xl text-neutral-700 dark:text-neutral-300 mb-12 leading-relaxed">
					The page you're looking for seems to have wandered off into the digital void.
					Don't worry though – let's get you back on track!
				</p>

				<!-- Action buttons -->
				<div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
					<a
						href="/"
						class="inline-flex items-center justify-center px-8 py-4 text-lg bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 rounded-lg hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200"
					>
						← Back Home
					</a>
				</div>

				<!-- Helpful links -->
				<div class="pt-8 border-t border-neutral-200 dark:border-neutral-800">
					<p class="text-base text-neutral-600 dark:text-neutral-300 mb-4">
						Looking for something specific?
					</p>
					<div class="flex flex-wrap justify-center gap-4 text-sm">
						<a
							href="/"
							class="text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white underline transition-colors"
						>
							Writing
						</a>
						<span class="text-neutral-400 dark:text-neutral-500">•</span>
						<a
							href="mailto:hello@martsokha.com"
							class="text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white underline transition-colors"
						>
							Contact
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>
