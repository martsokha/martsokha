---
import { Layout } from "@/layouts";

const pageTitle = "Page Not Found";
const pageDescription = "The page you're looking for doesn't exist.";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="container mx-auto px-4 py-16 max-w-4xl text-center">
		<div class="max-w-2xl mx-auto">
			<h1 class="text-8xl font-bold text-neutral-900 dark:text-neutral-100 mb-6">
				404
			</h1>
			<h2 class="text-3xl font-semibold text-neutral-700 dark:text-neutral-300 mb-8">
				Page Not Found
			</h2>
			<p class="text-xl text-neutral-600 dark:text-neutral-400 mb-16 leading-relaxed">
				Sorry, the page you're looking for doesn't exist. It might have been moved,
				deleted, or you entered the wrong URL.
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/"
					class="inline-block px-8 py-4 text-lg bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 rounded-lg hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
				>
					Go Home
				</a>
				<a
					href="/blog"
					class="inline-block px-8 py-4 text-lg border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 rounded-lg hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors"
				>
					Browse Blog
				</a>
			</div>

			<div class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800">
				<p class="text-base text-neutral-500 dark:text-neutral-500">
					If you think this is an error, please
					<a
						href="mailto:hello@martsokha.com"
						class="text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 underline transition-colors"
					>
						let me know
					</a>
					.
				</p>
			</div>
		</div>
	</div>
</Layout>
