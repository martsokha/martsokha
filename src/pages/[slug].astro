---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { calculateReadingTime } from "@/utils/content";

export async function getStaticPaths() {
	try {
		const blogEntries = await getCollection("posts");
		return blogEntries
			.filter((entry) => entry.data.isPublished)
			.map((entry) => ({
				params: { slug: entry.id },
				props: { entry },
			}));
	} catch (error: unknown) {
		console.error("Error fetching blog collection:", error);
		return [];
	}
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const readingTime = entry.body ? calculateReadingTime(entry.body) : 1;

const allPosts = (await getCollection("posts"))
	.filter((post) => post.data.isPublished)
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const currentIndex = allPosts.findIndex((post) => post.id === entry.id);
const previousPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="container mx-auto px-6 max-w-3xl">
    <!-- Header -->
    <header class="mb-12">
      <div class="flex items-center gap-3 text-sm text-neutral-400 dark:text-neutral-500 mb-6">
        <time>
          {new Date(entry.data.publishedAt).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span>&middot;</span>
        <span>{readingTime} min read</span>
        {entry.data.category && (
          <>
            <span>&middot;</span>
            <span>{entry.data.category}</span>
          </>
        )}
      </div>

      <h1 class="font-serif text-4xl md:text-5xl leading-tight text-neutral-900 dark:text-neutral-100 mb-4">
        {entry.data.title}
      </h1>

      {entry.data.excerpt && (
        <p class="text-lg text-neutral-500 dark:text-neutral-400 leading-relaxed">
          {entry.data.excerpt}
        </p>
      )}
    </header>

    <!-- Content -->
    <article class="mb-16">
      <div class="prose max-w-none text-neutral-800 dark:text-neutral-200" style="font-size: 1.0625rem;">
        <Content />
      </div>
    </article>

    <!-- Tags -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="mb-12 flex flex-wrap gap-2">
        {entry.data.tags.map(tag => (
          <span class="text-xs text-neutral-400 dark:text-neutral-500 border border-neutral-200 dark:border-neutral-800 px-3 py-1 rounded-full">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Navigation -->
    {(previousPost || nextPost) && (
      <nav class="border-t border-neutral-200 dark:border-neutral-800 pt-8 mb-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {previousPost && (
            <a href={`/${previousPost.id}`} class="group">
              <span class="text-xs text-neutral-400 dark:text-neutral-500 block mb-1">&larr; Previous</span>
              <span class="text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-500 dark:group-hover:text-neutral-400 transition-colors">
                {previousPost.data.title}
              </span>
            </a>
          )}
          {nextPost && (
            <a href={`/${nextPost.id}`} class="group sm:text-right sm:col-start-2">
              <span class="text-xs text-neutral-400 dark:text-neutral-500 block mb-1">Next &rarr;</span>
              <span class="text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-500 dark:group-hover:text-neutral-400 transition-colors">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}
  </div>
</Layout>
