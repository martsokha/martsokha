---
import { Layout } from "@/layouts";
import { getCollection, render } from "astro:content";
import { ArrowLeft, Github, ExternalLink } from "lucide-vue-next";
import { Badge } from "@/components/ui/badge";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const publishedDate = new Date(project.data.publishedAt).toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric'
}).toUpperCase();

// Meta information for structured data
const metaInfo = {
	publishedTime: project.data.publishedAt.toISOString(),
	...(project.data.updatedAt && { modifiedTime: project.data.updatedAt.toISOString() })
};
---

<Layout
	title={project.data.title}
	description={project.data.description}
	hideNavigation={true}
	{...metaInfo}
>
	<article class="container mx-auto px-4 py-16 max-w-4xl">
		<!-- Back Link and Meta -->
		<div class="mb-8 pb-6 border-b border-neutral-200 dark:border-neutral-800">
			<a
				href="/projects"
				class="inline-flex items-center text-base text-black dark:text-white hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors font-medium mb-4"
			>
				<ArrowLeft client:load class="w-5 h-5 mr-3" />
				Back to Projects
			</a>

			<!-- Project Meta -->
			<div class="flex items-center gap-3 text-sm text-neutral-600 dark:text-neutral-400 font-medium">
				<time datetime={project.data.publishedAt.toISOString()}>
					{publishedDate}
				</time>
				<span>•</span>
				<span class="capitalize">{project.data.status}</span>
			</div>
		</div>

		<!-- Project Title and Links -->
		<header class="mb-8">
			<div class="flex items-start justify-between mb-4">
				<h1 class="text-4xl md:text-5xl font-bold text-black dark:text-white leading-tight flex-1 pr-8">
					{project.data.title}
				</h1>

				<!-- Project Links -->
				{(project.data.github || project.data.demo) && (
					<div class="flex flex-wrap gap-3 flex-shrink-0">
						{project.data.github && (
							<a
								href={project.data.github}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-sm px-4 py-2 rounded-lg border border-neutral-300 dark:border-neutral-700 text-black dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium"
							>
								<Github client:load class="w-4 h-4 mr-2" />
								View Code
							</a>
						)}
						{project.data.demo && (
							<a
								href={project.data.demo}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center text-sm px-4 py-2 rounded-lg border border-neutral-300 dark:border-neutral-700 text-black dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors font-medium"
							>
								<ExternalLink client:load class="w-4 h-4 mr-2" />
								Live Demo
							</a>
						)}
					</div>
				)}
			</div>
			<p class="text-xl text-neutral-700 dark:text-neutral-300 leading-relaxed">
				{project.data.description}
			</p>
		</header>

		<!-- Project Content -->
		<div class="prose prose-neutral dark:prose-invert prose-lg max-w-none leading-relaxed mb-16">
			<Content />
		</div>

		<!-- Tags at the bottom -->
		{project.data.tags && project.data.tags.length > 0 && (
			<div class="border-t border-neutral-200 dark:border-neutral-800 pt-8">
				<div class="flex flex-wrap gap-2">
					{project.data.tags.map((tag: string) => (
						<Badge variant="outline" class="text-base px-4 py-2 bg-neutral-50 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors">
							#{tag}
						</Badge>
					))}
				</div>
			</div>
		)}
	</article>
</Layout>
