---
import { Layout } from "@/layouts";

const pageTitle = "Oleh Martsokha";
const pageDescription =
	"Software engineer passionate about building exceptional digital experiences and exploring new technologies.";
---

<Layout title={pageTitle} description={pageDescription}>
	<!-- Hero Section -->
	<div class="py-24 flex items-center justify-center">
		<div class="container mx-auto px-4 max-w-4xl text-center">
			<h1 class="text-5xl md:text-6xl font-bold text-black dark:text-white mb-8 leading-tight">
				Hey, I'm Oleh
			</h1>
			<div class="prose prose-lg max-w-none text-neutral-800 dark:text-neutral-300 leading-relaxed mx-auto">
				<p class="text-xl mb-6">
					I'm a software engineer who loves crafting digital experiences that matter.
					When I'm not coding, you'll find me exploring new technologies, sharing insights,
					or diving into creative projects.
				</p>
				<p class="text-xl">
					I believe in the power of community and sharing knowledge.
					That's why I write about my experiences, contribute to open source,
					and connect with fellow creators and engineers.
				</p>
			</div>
		</div>
	</div>
</Layout>
