---
import { Layout } from "@/layouts";

const pageTitle = "Oleh Martsokha";
const pageDescription = "Software engineer passionate about building exceptional digital experiences and exploring new technologies.";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="container mx-auto px-4 py-12 max-w-4xl">
		<!-- Hero Section -->
		<section class="min-h-[70vh] flex items-center justify-center">
			<div class="text-center">
				<h1 class="text-5xl md:text-6xl font-bold text-neutral-900 dark:text-neutral-100 mb-8">
					Hi, I'm Oleh Martsokha
				</h1>
				<p class="text-2xl text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-3xl">
					Software engineer passionate about building exceptional digital experiences
					and exploring new technologies. I write about development, design, and the
					intersection of technology and creativity.
				</p>
			</div>
		</section>
	</div>
</Layout>
