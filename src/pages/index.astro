---
import { Layout } from "@/layouts";
import { calculateReadingTime } from "@/utils/content";
import { getCollection } from "astro:content";

const blogEntries = (await getCollection("posts"))
	.filter((entry) => entry.data.isPublished)
	.map((entry) => ({
		...entry,
		readingTime: entry.body ? calculateReadingTime(entry.body) : 1,
	}))
	.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Group posts by year
const postsByYear = blogEntries.reduce<Record<string, typeof blogEntries>>((acc, post) => {
	const year = new Date(post.data.publishedAt).getFullYear().toString();
	if (!acc[year]) acc[year] = [];
	acc[year].push(post);
	return acc;
}, {});

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<Layout title="Blog" description="Personal insights, stories, and updates from my journey in tech">
  {blogEntries.length > 0 ? (
    <div class="container mx-auto px-6 max-w-3xl">
      {years.map((year) => (
        <section class="mb-16">
          <h2 class="font-serif text-lg tracking-normal text-neutral-400 dark:text-neutral-500 mb-8">{year}</h2>
          <div class="space-y-8">
            {postsByYear[year].map((post) => (
              <a
                href={`/${post.id}`}
                class="group block -mx-3 px-3 py-4 rounded-lg transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-900"
              >
                <div class="flex items-baseline gap-4 mb-1">
                  <time class="text-sm tracking-normal text-neutral-400 dark:text-neutral-500 shrink-0 tabular-nums">
                    {new Date(post.data.publishedAt).toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric'
                    })}
                  </time>
                  {post.data.category && (
                    <span class="text-xs tracking-normal text-neutral-400 dark:text-neutral-500">
                      {post.data.category}
                    </span>
                  )}
                  <span class="text-xs tracking-normal text-neutral-400 dark:text-neutral-500 hidden sm:block ml-auto">
                    {post.readingTime} min read
                  </span>
                </div>
                <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors mb-1">
                  {post.data.title}
                </h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-3 leading-relaxed">
                  {post.data.excerpt || post.data.description}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  ) : (
    <div class="container mx-auto px-6 max-w-3xl min-h-[50vh] flex items-center justify-center">
      <div class="text-center">
        <h1 class="font-serif text-6xl tracking-normal text-neutral-900 dark:text-neutral-100 mb-4">204</h1>
        <p class="text-neutral-500 dark:text-neutral-400 mb-8">No posts yet.</p>
        <a
          href="mailto:hello@martsokha.com"
          class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors underline underline-offset-4 decoration-neutral-300 dark:decoration-neutral-600"
        >
          Get in touch
        </a>
      </div>
    </div>
  )}
</Layout>
