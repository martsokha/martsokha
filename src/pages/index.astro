---
import { Layout } from "@/layouts";

const pageTitle = "Oleh Martsokha";
const pageDescription = "Software engineer passionate about building exceptional digital experiences and exploring new technologies.";
---

<Layout title={pageTitle} description={pageDescription}>
	<div class="container mx-auto px-4 py-16 max-w-4xl">
		<!-- Hero Section -->
		<section class="min-h-[75vh] flex items-center justify-center">
			<div class="text-center max-w-4xl">
				<h1 class="text-6xl md:text-7xl font-bold text-black dark:text-white mb-12 leading-tight tracking-tight">
					Hi, I'm Oleh Martsokha
				</h1>
				<p class="text-xl md:text-2xl text-neutral-800 dark:text-neutral-100 leading-relaxed max-w-3xl mx-auto font-light">
					Software engineer passionate about building exceptional digital experiences
					and exploring new technologies. I write about development, design, and the
					intersection of technology and creativity.
				</p>
			</div>
		</section>
	</div>
</Layout>
